{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "KalshiBackTest",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "pages": [
          "index",
          "quickstart",
          "api-keys",
          "rate-limits",
          "available-data",
          "fetching-data",
          "data-retention"
        ]
      },
      {
        "tab": "API Reference",
        "pages": [
          "api-reference/introduction",
          "api-reference/authorization",
          {
            "group": "API v1",
            "expanded": true,
            "pages": [
              "api-reference/v1/overview",
              "api-reference/v1/error-codes",
              {
                "group": "Kalshi Markets",
                "expanded": true,
                "pages": [
                  "api-reference/v1/list-markets",
                  "api-reference/v1/get-market",
                  "api-reference/v1/list-snapshots",
                  "api-reference/v1/snapshot-at"
                ]
              },
              {
                "group": "Utility",
                "expanded": true,
                "pages": [
                  "api-reference/v1/health"
                ]
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "API Reference",
          "href": "/api-reference",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Dashboard",
          "href": "https://kalshibacktest.com/dashboard",
          "icon": "gauge"
        },
        {
          "anchor": "Website",
          "href": "https://kalshibacktest.com",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@kalshibacktest.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://kalshibacktest.com/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/",
      "github": "https://github.com/",
      "linkedin": "https://linkedin.com/"
    }
  }
}
